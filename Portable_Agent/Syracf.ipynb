        "#**Preparar o Dataset - BT**\n"
      ],
      "metadata": {
        "id": "3MuHPVLHJ3uv"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# ============================================================\n",
        "# SELENE — VERIFICAÇÃO E PREPARAÇÃO DO DATASET\n",
        "# Gemma 3 4B Instruct | dados.json\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "from collections import Counter\n",
        "from datasets import Dataset\n",
        "\n",
        "# ----------------------------\n",
        "# 1. Configuração\n",
        "# ----------------------------\n",
        "\n",
        "ARQUIVO = \"dados.json\"\n",
        "\n",
        "if not os.path.isfile(ARQUIVO):\n",
        "    raise FileNotFoundError(\n",
        "        f\"Arquivo '{ARQUIVO}' não encontrado. \"\n",
        "        \"Envie dados.json para o ambiente do Colab.\"\n",
        "    )\n",
        "\n",
        "# Reutiliza o prompt definido anteriormente, se existir.\n",
        "SYSTEM = globals().get(\n",
        "    \"SYSTEM_PROMPT\",\n",
        "    \"Você é Selene, uma assistente de inteligência artificial. \"\n",
        "    \"Mantenha sua identidade e responda de forma clara e consistente.\"\n",
        ")\n",
        "\n",
        "# Verifica se o tokenizador do Gemma já está carregado.\n",
        "if \"tokenizer\" not in globals():\n",
        "    raise RuntimeError(\n",
        "        \"Tokenizador não encontrado. Execute primeiro a célula \"\n",
        "        \"que carrega o Gemma 3 4B Instruct.\"\n",
        "    )\n",
        "\n",
        "# ----------------------------\n",
        "# 2. Ler o JSON\n",
        "# ----------------------------\n",
        "\n",
        "with open(ARQUIVO, \"r\", encoding=\"utf-8\") as f:\n",
        "    dados = json.load(f)\n",
        "\n",
        "if isinstance(dados, dict):\n",
        "    for chave in (\"data\", \"examples\", \"dados\"):\n",
        "        if isinstance(dados.get(chave), list):\n",
        "            dados = dados[chave]\n",
        "            break\n",
        "    else:\n",
        "        dados = [dados]\n",
        "\n",
        "if not isinstance(dados, list) or not dados:\n",
        "    raise ValueError(\"O JSON não contém uma lista de exemplos válida.\")\n",
        "\n",
        "print(\"Exemplos encontrados:\", len(dados))\n",
        "\n",
        "# ----------------------------\n",
        "# 3. Validar e normalizar\n",
        "# ----------------------------\n",
        "\n",
        "exemplos = []\n",
        "ignorados = Counter()\n",
        "avisos = Counter()\n",
        "\n",
        "for indice, item in enumerate(dados):\n",
        "    if not isinstance(item, dict):\n",
        "        ignorados[\"item não é um objeto\"] += 1\n",
        "        continue\n",
        "\n",
        "    mensagens = item.get(\"messages\")\n",
        "\n",
        "    if isinstance(mensagens, list) and mensagens:\n",
        "        msgs = []\n",
        "\n",
        "        for m in mensagens:\n",
        "            if not isinstance(m, dict):\n",
        "                avisos[\"mensagem malformada\"] += 1\n",
        "                continue\n",
        "\n",
        "            role = m.get(\"role\")\n",
        "            content = m.get(\"content\")\n",
        "\n",
        "            if role not in (\"system\", \"user\", \"assistant\"):\n",
        "                avisos[\"papel desconhecido\"] += 1\n",
        "                continue\n",
        "\n",
        "            if not isinstance(content, str) or not content.strip():\n",
        "                avisos[\"conteúdo vazio ou inválido\"] += 1\n",
        "                continue\n",
        "\n",
        "            msgs.append({\n",
        "                \"role\": role,\n",
        "                \"content\": content.strip()\n",
        "            })\n",
        "\n",
        "        if not msgs:\n",
        "            ignorados[\"sem mensagens válidas\"] += 1\n",
        "            continue\n",
        "\n",
        "        # Adiciona system somente quando não existe.\n",
        "        if msgs[0][\"role\"] != \"system\":\n",
        "            msgs.insert(0, {\n",
        "                \"role\": \"system\",\n",
        "                \"content\": SYSTEM\n",
        "            })\n",
        "\n",
        "        # Confere se há pelo menos uma pergunta e uma resposta.\n",
        "        roles = [m[\"role\"] for m in msgs]\n",
        "\n",
        "        if \"user\" not in roles or \"assistant\" not in roles:\n",
        "            ignorados[\"sem user ou assistant\"] += 1\n",
        "            continue\n",
        "\n",
        "    else:\n",
        "        pergunta = item.get(\"pergunta\")\n",
        "        resposta = item.get(\"resposta\")\n",
        "\n",
        "        if (\n",
        "            not isinstance(pergunta, str)\n",
        "            or not pergunta.strip()\n",
        "            or not isinstance(resposta, str)\n",
        "            or not resposta.strip()\n",
        "        ):\n",
        "            ignorados[\"pergunta ou resposta inválida\"] += 1\n",
        "            continue\n",
        "\n",
        "        msgs = [\n",
        "            {\"role\": \"system\", \"content\": SYSTEM},\n",
        "            {\"role\": \"user\", \"content\": pergunta.strip()},\n",
        "            {\"role\": \"assistant\", \"content\": resposta.strip()}\n",
        "        ]\n",
        "\n",
        "    exemplos.append({\"messages\": msgs})\n",
        "\n",
        "if not exemplos:\n",
        "    raise ValueError(\"Nenhum exemplo válido foi encontrado.\")\n",
        "\n",
        "# ----------------------------\n",
        "# 4. Converter para o template do Gemma\n",
        "# ----------------------------\n",
        "\n",
        "textos = []\n",
        "\n",
        "for indice, exemplo in enumerate(exemplos):\n",
        "    try:\n",
        "        texto = tokenizer.apply_chat_template(\n",
        "            exemplo[\"messages\"],\n",
        "            tokenize=False,\n",
        "            add_generation_prompt=False\n",
        "        )\n",
        "\n",
        "        if not isinstance(texto, str) or not texto.strip():\n",
        "            ignorados[\"template vazio\"] += 1\n",
        "            continue\n",
        "\n",
        "        textos.append({\"text\": texto})\n",
        "\n",
        "    except Exception as erro:\n",
        "        ignorados[\"erro no template\"] += 1\n",
        "        print(f\"Aviso no exemplo {indice}: {erro}\")\n",
        "\n",
        "if not textos:\n",
        "    raise ValueError(\"Nenhum exemplo pôde ser convertido pelo template.\")\n",
        "\n",
        "# Dataset pronto para inspeção e posterior treinamento.\n",
        "dataset = Dataset.from_list(textos)\n",
        "\n",
        "# ----------------------------\n",
        "# 5. Relatório\n",
        "# ----------------------------\n",
        "\n",
        "print(\"\\n========== RELATÓRIO DO DATASET ==========\")\n",
        "print(\"Arquivo:\", ARQUIVO)\n",
        "print(\"Registros originais:\", len(dados))\n",
        "print(\"Exemplos normalizados:\", len(exemplos))\n",
        "print(\"Exemplos preparados:\", len(dataset))\n",
        "print(\"Registros ignorados/erros:\", sum(ignorados.values()))\n",
        "\n",
        "if ignorados:\n",
        "    print(\"\\nMotivos de descarte ou erro:\")\n",
        "    for motivo, quantidade in ignorados.items():\n",
        "        print(f\"  - {motivo}: {quantidade}\")\n",
        "\n",
        "if avisos:\n",
        "    print(\"\\nAvisos de validação:\")\n",
        "    for motivo, quantidade in avisos.items():\n",
        "        print(f\"  - {motivo}: {quantidade}\")\n",
        "\n",
        "print(\"\\n========== PRIMEIRO EXEMPLO ==========\")\n",
        "print(dataset[0][\"text\"][:1000])\n",
        "\n",
        "print(\"\\nDataset preparado na variável: dataset\")\n",
        "print(\"Coluna de texto: text\")\n",
        "print(\"Nenhum treinamento foi iniciado.\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
