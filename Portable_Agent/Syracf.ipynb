    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# SELENE — TREINAMENTO LoRA (OTIMIZADO)\n",
        "# Gemma 3 4B Instruct | QLoRA 4-bit\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import gc\n",
        "import torch\n",
        "\n",
        "from unsloth import FastLanguageModel, is_bfloat16_supported\n",
        "from trl import SFTTrainer, SFTConfig\n",
        "from unsloth.chat_templates import train_on_responses_only\n",
        "\n",
        "# ============================================================\n",
        "# 1. PARÂMETROS EDITÁVEIS\n",
        "# ============================================================\n",
        "\n",
        "# Seus exemplos têm em média 100 a 200 tokens. 384 dá folga e acelera muito!\n",
        "MAX_SEQ_LENGTH = 384\n",
        "\n",
        "# 4 épocas focando apenas na resposta garantem convergência rápida sem queimar VRAM\n",
        "EPOCHS = 4\n",
        "\n",
        "# Microbatch 4 cabe com muita folga na VRAM com 384 tokens\n",
        "BATCH_SIZE = 4\n",
        "GRAD_ACCUMULATION = 2       # Batch efetivo = 4 * 2 = 8\n",
        "\n",
        "LEARNING_RATE = 2e-4\n",
        "WEIGHT_DECAY = 0.01\n",
        "LR_SCHEDULER = \"cosine\"\n",
        "\n",
        "# OBRIGATÓRIO ser False para o mascaramento de respostas funcionar\n",
        "PACKING = False\n",
        "\n",
        "OUTPUT_DIR = \"selene-checkpoints\"\n",
        "FINAL_DIR = \"selene-lora-final\"\n",
        "SAVE_STEPS = 50\n",
        "SAVE_TOTAL_LIMIT = 2\n",
        "LOGGING_STEPS = 5\n",
        "SEED = 3407\n",
        "\n",
        "# ============================================================\n",
        "# 2. VERIFICAÇÕES\n",
        "# ============================================================\n",
        "\n",
        "if not torch.cuda.is_available():\n",
        "    raise RuntimeError(\"Nenhuma GPU CUDA disponível.\")\n",
        "\n",
        "if \"model\" not in globals() or \"tokenizer\" not in globals():\n",
        "    raise RuntimeError(\n",
        "        \"Execute primeiro as células de carregamento do modelo \"\n",
        "        \"e de preparação do LoRA.\"\n",
        "    )\n",
        "\n",
        "if \"dataset\" not in globals():\n",
        "    raise RuntimeError(\n",
        "        \"Dataset não encontrado. Execute a célula de preparação \"\n",
        "        \"do dados.json primeiro.\"\n",
        "    )\n",
        "\n",
        "if len(dataset) == 0:\n",
        "    raise ValueError(\"O dataset está vazio.\")\n",
        "\n",
        "if \"text\" not in dataset.column_names:\n",
        "    raise ValueError(\"O dataset precisa conter a coluna 'text'.\")\n",
        "\n",
        "gc.collect()\n",
        "torch.cuda.empty_cache()\n",
        "\n",
        "print(\"GPU:\", torch.cuda.get_device_name(0))\n",
        "print(\n",
        "    \"VRAM total:\",\n",
        "    round(torch.cuda.get_device_properties(0).total_memory / 1024**3, 2),\n",
        "    \"GB\"\n",
        ")\n",
        "print(\"Exemplos:\", len(dataset))\n",
        "print(\"Épocas:\", EPOCHS)\n",
        "print(\"Batch efetivo aproximado:\", BATCH_SIZE * GRAD_ACCUMULATION)\n",
        "\n",
        "# ============================================================\n",
        "# 3. PREPARAR MODELO PARA TREINAMENTO\n",
        "# ============================================================\n",
        "\n",
        "FastLanguageModel.for_training(model)\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "USE_BF16 = is_bfloat16_supported()\n",
        "USE_FP16 = not USE_BF16\n",
        "\n",
        "# ============================================================\n",
        "# 4. CONFIGURAR O TREINADOR\n",
        "# ============================================================\n",
        "\n",
        "training_args = SFTConfig(\n",
        "    output_dir=OUTPUT_DIR,\n",
        "    max_length=MAX_SEQ_LENGTH,\n",
        "    dataset_text_field=\"text\",\n",
        "    packing=PACKING,\n",
        "    per_device_train_batch_size=BATCH_SIZE,\n",
        "    gradient_accumulation_steps=GRAD_ACCUMULATION,\n",
        "    gradient_checkpointing=True,\n",
        "    num_train_epochs=EPOCHS,\n",
        "    learning_rate=LEARNING_RATE,\n",
        "    lr_scheduler_type=LR_SCHEDULER,\n",
        "    weight_decay=WEIGHT_DECAY,\n",
        "    fp16=USE_FP16,\n",
        "    bf16=USE_BF16,\n",
        "    optim=\"adamw_8bit\",\n",
        "    dataloader_num_workers=0,\n",
        "    dataloader_pin_memory=False,\n",
        "    logging_steps=LOGGING_STEPS,\n",
        "    save_strategy=\"steps\",\n",
        "    save_steps=SAVE_STEPS,\n",
        "    save_total_limit=SAVE_TOTAL_LIMIT,\n",
        "    eval_strategy=\"no\",\n",
        "    seed=SEED,\n",
        "    report_to=\"none\",\n",
        "    remove_unused_columns=False,\n",
        ")\n",
        "\n",
        "trainer = SFTTrainer(\n",
        "    model=model,\n",
        "    processing_class=tokenizer,\n",
        "    train_dataset=dataset,\n",
        "    args=training_args,\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 5. MASCARA AS PERGUNTAS E TREINA SÓ NAS RESPOSTAS DA SELENE\n",
        "# ============================================================\n",
        "# Aplica diretamente as tags oficiais do Gemma para isolar a loss\n",
        "trainer = train_on_responses_only(\n",
        "    trainer,\n",
        "    instruction_part=\"<start_of_turn>user\\n\",\n",
        "    response_part=\"<start_of_turn>model\\n\",\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 6. EXECUTAR TREINAMENTO\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\nIniciando treinamento otimizado da Selene...\")\n",
        "\n",
        "resultado = trainer.train()\n",
        "\n",
        "print(\"\\nTreinamento concluído.\")\n",
        "print(\"Loss final:\", resultado.training_loss)"
      ],
