      "cell_type": "markdown",
      "source": [
        "Aqui upamos as quantizações"
      ],
      "metadata": {
        "id": "i7yu0Ke2UJlK"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXPORTAÇÃO E UPLOAD DIRETO PARA O HUGGING FACE (GGUF Q3 a Q8)\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import gc\n",
        "import torch\n",
        "\n",
        "# Repositório de destino no Hugging Face\n",
        "HF_GGUF_REPO = \"Syradevops/Selene-Rebel-4B-Instruct_gguf\"\n",
        "\n",
        "# Token HF com permissão de escrita (Write)\n",
        "TK_hf = \"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\"\n",
        "\n",
        "# Lista com todas as quantizações desejadas (da mais leve à máxima qualidade)\n",
        "QUANTS = [\n",
        "    \"q3_k_m\",  # Ultraleve (~1.9 GB)\n",
        "    \"q4_k_m\",  # Recomendada - Equilíbrio perfeito (~2.4 GB)\n",
        "    \"q5_k_m\",  # Alta precisão (~2.8 GB)\n",
        "    \"q8_0\",    # Qualidade máxima sem perdas perceptíveis (~4.2 GB)\n",
        "]\n",
        "\n",
        "print(f\"Iniciando conversão e envio para: {HF_GGUF_REPO}\")\n",
        "print(f\"Formatos selecionados: {', '.join(QUANTS)}\")\n",
        "print(\"Isso pode levar alguns minutos dependendo da sua conexão e CPU...\")\n",
        "\n",
        "# Limpeza de memória da GPU antes de compilar\n",
        "gc.collect()\n",
        "torch.cuda.empty_cache()\n",
        "\n",
        "# Faz a quantização de todas as variantes e envia direto para o Hugging Face\n",
        "model.push_to_hub_gguf(\n",
        "    HF_GGUF_REPO,\n",
        "    tokenizer,\n",
        "    quantization_method = QUANTS,\n",
        "    token = TK_hf\n",
        ")\n",
        "\n",
        "print(f\"\\n🎉 Sucesso! Todos os arquivos GGUF foram enviados para:\")\n",
        "print(f\"👉 https://huggingface.co/{HF_GGUF_REPO}\")"
      ],
