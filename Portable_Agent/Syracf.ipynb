      "cell_type": "code",
      "source": [
        "\n",
        "import gc\n",
        "import torch\n",
        "from unsloth import FastLanguageModel\n",
        "\n",
        "# ============================================================\n",
        "# SELENE — DOWNLOAD E PREPARAÇÃO DO MODELO\n",
        "# Gemma 3 4B Instruct | QLoRA 4-bit\n",
        "# ============================================================\n",
        "\n",
        "gc.collect()\n",
        "\n",
        "if not torch.cuda.is_available():\n",
        "    raise RuntimeError(\"Nenhuma GPU CUDA disponível.\")\n",
        "\n",
        "torch.cuda.empty_cache()\n",
        "\n",
        "print(\"GPU:\", torch.cuda.get_device_name(0))\n",
        "print(\n",
        "    \"VRAM total:\",\n",
        "    round(torch.cuda.get_device_properties(0).total_memory / 1024**3, 2),\n",
        "    \"GB\"\n",
        ")\n",
        "\n",
        "# Configurações de carregamento\n",
        "MODEL_NAME = \"unsloth/gemma-3-4b-it\"\n",
        "MAX_SEQ_LENGTH = 2048\n",
        "LOAD_IN_4BIT = True\n",
        "DTYPE = None\n",
        "\n",
        "print(f\"\\nBaixando/carregando: {MODEL_NAME}\")\n",
        "print(\"Quantização: 4 bits\")\n",
        "print(f\"Comprimento máximo: {MAX_SEQ_LENGTH} tokens\")\n",
        "\n",
        "# Baixa os arquivos, se necessário, e carrega o modelo\n",
        "model, tokenizer = FastLanguageModel.from_pretrained(\n",
        "    model_name=MODEL_NAME,\n",
        "    max_seq_length=MAX_SEQ_LENGTH,\n",
        "    dtype=DTYPE,\n",
        "    load_in_4bit=LOAD_IN_4BIT,\n",
        "    trust_remote_code=False,\n",
        ")\n",
        "\n",
        "# Prepara o modelo para inferência\n",
        "FastLanguageModel.for_inference(model)\n",
        "\n",
        "print(\"\\nModelo baixado e carregado.\")\n",
        "print(\"Tokenizador preparado.\")\n",
        "print(\"Pronto para inferência ou avaliação.\")\n",
        "print(\n",
        "    \"VRAM utilizada:\",\n",
        "    round(torch.cuda.memory_allocated(0) / 1024**3, 2),\n",
        "    \"GB\"\n",
        ")\n"
      ],
