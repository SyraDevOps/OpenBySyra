      "cell_type": "markdown",
      "source": [
        "#**Prepara o Dataset - N**"
      ],
      "metadata": {
        "id": "XpNBn4IpuCFb"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# ============================================================\n",
        "# SELENE — VERIFICAÇÃO E PREPARAÇÃO DO DATASET\n",
        "# Gemma 3 4B Instruct | dados.json\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "from collections import Counter\n",
        "from datasets import Dataset\n",
        "\n",
        "# ----------------------------\n",
        "# 1. Configuração\n",
        "# ----------------------------\n",
        "\n",
        "ARQUIVO = \"dados.json\"\n",
        "\n",
        "if not os.path.isfile(ARQUIVO):\n",
        "    raise FileNotFoundError(\n",
        "        f\"Arquivo '{ARQUIVO}' não encontrado. \"\n",
        "        \"Envie dados.json para o ambiente do Colab.\"\n",
        "    )\n",
        "\n",
        "# Reutiliza o prompt definido anteriormente, se existir.\n",
        "SYSTEM = globals().get(\n",
        "    \"SYSTEM_PROMPT\",\n",
        "    \"Você é Selene, uma assistente de inteligência artificial. \"\n",
        "    \"Mantenha sua identidade e responda de forma clara e consistente.\"\n",
        ")\n",
        "\n",
        "# Verifica se o tokenizador do Gemma já está carregado.\n",
        "if \"tokenizer\" not in globals():\n",
        "    raise RuntimeError(\n",
        "        \"Tokenizador não encontrado. Execute primeiro a célula \"\n",
        "        \"que carrega o Gemma 3 4B Instruct.\"\n",
        "    )\n",
        "\n",
        "# ----------------------------\n",
        "# 2. Ler o JSON\n",
        "# ----------------------------\n",
        "\n",
        "with open(ARQUIVO, \"r\", encoding=\"utf-8\") as f:\n",
        "    dados = json.load(f)\n",
        "\n",
        "if isinstance(dados, dict):\n",
        "    for chave in (\"data\", \"examples\", \"dados\"):\n",
        "        if isinstance(dados.get(chave), list):\n",
        "            dados = dados[chave]\n",
        "            break\n",
        "    else:\n",
        "        dados = [dados]\n",
        "\n",
        "if not isinstance(dados, list) or not dados:\n",
        "    raise ValueError(\"O JSON não contém uma lista de exemplos válida.\")\n",
        "\n",
        "print(\"Exemplos encontrados:\", len(dados))\n",
        "\n",
        "# ----------------------------\n",
        "# 3. Validar e normalizar\n",
        "# ----------------------------\n",
        "\n",
        "exemplos = []\n",
        "ignorados = Counter()\n",
        "avisos = Counter()\n",
        "\n",
        "for indice, item in enumerate(dados):\n",
        "    if not isinstance(item, dict):\n",
        "        ignorados[\"item não é um objeto\"] += 1\n",
        "        continue\n",
        "\n",
        "    mensagens = item.get(\"messages\")\n",
        "\n",
        "    if isinstance(mensagens, list) and mensagens:\n",
        "        msgs = []\n",
        "\n",
        "        for m in mensagens:\n",
        "            if not isinstance(m, dict):\n",
        "                avisos[\"mensagem malformada\"] += 1\n",
        "                continue\n",
        "\n",
        "            role = m.get(\"role\")\n",
        "            content = m.get(\"content\")\n",
        "\n",
        "            if role not in (\"system\", \"user\", \"assistant\"):\n",
        "                avisos[\"papel desconhecido\"] += 1\n",
        "                continue\n",
        "\n",
        "            if not isinstance(content, str) or not content.strip():\n",
        "                avisos[\"conteúdo vazio ou inválido\"] += 1\n",
        "                continue\n",
        "\n",
        "            msgs.append({\n",
        "                \"role\": role,\n",
        "                \"content\": content.strip()\n",
        "            })\n",
        "\n",
        "        if not msgs:\n",
        "            ignorados[\"sem mensagens válidas\"] += 1\n",
        "            continue\n",
        "\n",
        "        # Adiciona system somente quando não existe.\n",
        "        if msgs[0][\"role\"] != \"system\":\n",
        "            msgs.insert(0, {\n",
        "                \"role\": \"system\",\n",
        "                \"content\": SYSTEM\n",
        "            })\n",
        "\n",
        "        # Confere se há pelo menos uma pergunta e uma resposta.\n",
        "        roles = [m[\"role\"] for m in msgs]\n",
        "\n",
        "        if \"user\" not in roles or \"assistant\" not in roles:\n",
        "            ignorados[\"sem user ou assistant\"] += 1\n",
        "            continue\n",
        "\n",
        "    else:\n",
        "        pergunta = item.get(\"pergunta\")\n",
        "        resposta = item.get(\"resposta\")\n",
        "\n",
        "        if (\n",
        "            not isinstance(pergunta, str)\n",
        "            or not pergunta.strip()\n",
        "            or not isinstance(resposta, str)\n",
        "            or not resposta.strip()\n",
        "        ):\n",
        "            ignorados[\"pergunta ou resposta inválida\"] += 1\n",
        "            continue\n",
        "\n",
        "        msgs = [\n",
        "            {\"role\": \"system\", \"content\": SYSTEM},\n",
        "            {\"role\": \"user\", \"content\": pergunta.strip()},\n",
        "            {\"role\": \"assistant\", \"content\": resposta.strip()}\n",
        "        ]\n",
        "\n",
        "    exemplos.append({\"messages\": msgs})\n",
        "\n",
        "if not exemplos:\n",
        "    raise ValueError(\"Nenhum exemplo válido foi encontrado.\")\n",
        "\n",
        "# ----------------------------\n",
        "# 4. Converter para o template do Gemma\n",
        "# ----------------------------\n",
        "\n",
        "textos = []\n",
        "\n",
        "for indice, exemplo in enumerate(exemplos):\n",
        "    try:\n",
        "        texto = tokenizer.apply_chat_template(\n",
        "            exemplo[\"messages\"],\n",
        "            tokenize=False,\n",
        "            add_generation_prompt=False\n",
        "        )\n",
        "\n",
        "        if not isinstance(texto, str) or not texto.strip():\n",
        "            ignorados[\"template vazio\"] += 1\n",
        "            continue\n",
        "\n",
        "        textos.append({\"text\": texto})\n",
        "\n",
        "    except Exception as erro:\n",
        "        ignorados[\"erro no template\"] += 1\n",
        "        print(f\"Aviso no exemplo {indice}: {erro}\")\n",
        "\n",
        "if not textos:\n",
        "    raise ValueError(\"Nenhum exemplo pôde ser convertido pelo template.\")\n",
        "\n",
        "# Dataset pronto para inspeção e posterior treinamento.\n",
        "dataset = Dataset.from_list(textos)\n",
        "\n",
        "# ----------------------------\n",
        "# 5. Relatório\n",
        "# ----------------------------\n",
        "\n",
        "print(\"\\n========== RELATÓRIO DO DATASET ==========\")\n",
        "print(\"Arquivo:\", ARQUIVO)\n",
        "print(\"Registros originais:\", len(dados))\n",
        "print(\"Exemplos normalizados:\", len(exemplos))\n",
        "print(\"Exemplos preparados:\", len(dataset))\n",
        "print(\"Registros ignorados/erros:\", sum(ignorados.values()))\n",
        "\n",
        "if ignorados:\n",
        "    print(\"\\nMotivos de descarte ou erro:\")\n",
        "    for motivo, quantidade in ignorados.items():\n",
        "        print(f\"  - {motivo}: {quantidade}\")\n",
        "\n",
        "if avisos:\n",
        "    print(\"\\nAvisos de validação:\")\n",
        "    for motivo, quantidade in avisos.items():\n",
        "        print(f\"  - {motivo}: {quantidade}\")\n",
        "\n",
        "print(\"\\n========== PRIMEIRO EXEMPLO ==========\")\n",
        "print(dataset[0][\"text\"][:1000])\n",
        "\n",
        "print(\"\\nDataset preparado na variável: dataset\")\n",
        "print(\"Coluna de texto: text\")\n",
        "print(\"Nenhum treinamento foi iniciado.\")\n"
      ],
      "metadata": {
        "id": "_gWvHJl-qR3H"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "#**Treinamento - N**"
      ],
      "metadata": {
        "id": "gl-YOhm0szw2"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# ============================================================\n",
        "# SELENE — TREINAMENTO LoRA\n",
        "# Gemma 3 4B Instruct | QLoRA 4-bit\n",
        "# Pré-requisitos:\n",
        "#   - model: Gemma já carregado e com LoRA configurado\n",
        "#   - tokenizer: tokenizador do Gemma\n",
        "#   - dataset: dataset preparado a partir do dados.json\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import gc\n",
        "import torch\n",
        "\n",
        "from unsloth import FastLanguageModel, is_bfloat16_supported\n",
        "from trl import SFTTrainer, SFTConfig\n",
        "\n",
        "# ============================================================\n",
        "# 1. PARÂMETROS EDITÁVEIS\n",
        "# ============================================================\n",
        "\n",
        "# >>> DATASET E SEQUÊNCIAS\n",
        "\n",
        "MAX_SEQ_LENGTH = 1024       # <<< EDITAR\n",
        "# 512: menos memória e processamento; pode truncar exemplos longos.\n",
        "# 1024: opção intermediária.\n",
        "# 2048: preserva mais contexto, mas aumenta o consumo de VRAM.\n",
        "# Deve ser compatível com o comprimento usado ao carregar o modelo.\n",
        "\n",
        "# >>> DURAÇÃO DO TREINAMENTO\n",
        "\n",
        "EPOCHS = 8                  # <<< EDITAR\n",
        "# 1: treino mais curto; pode ser insuficiente.\n",
        "# 3: ponto de partida razoável.\n",
        "# 5 ou mais: mais exposição aos dados, mas maior risco de overfitting.\n",
        "\n",
        "# >>> TAMANHO DO LOTE\n",
        "\n",
        "BATCH_SIZE = 2              # <<< EDITAR\n",
        "# Quantidade de sequências processadas por microbatch.\n",
        "# Reduza para 1 se faltar VRAM.\n",
        "# Aumentar consome mais memória.\n",
        "\n",
        "GRAD_ACCUMULATION = 4       # <<< EDITAR\n",
        "# Acumula gradientes antes de atualizar os adaptadores.\n",
        "# 2, 4 ou 8 são valores comuns.\n",
        "# Batch efetivo aproximado = BATCH_SIZE * GRAD_ACCUMULATION\n",
        "# Considerando uma única GPU.\n",
        "\n",
        "# >>> TAXA DE APRENDIZADO\n",
        "\n",
        "LEARNING_RATE = 1e-4        # <<< EDITAR\n",
        "# 1e-4: ponto de partida para muitos ajustes LoRA.\n",
        "# 5e-5: atualização mais conservadora.\n",
        "# 2e-4: atualização mais agressiva; pode prejudicar a estabilidade.\n",
        "\n",
        "# >>> OTIMIZAÇÃO\n",
        "\n",
        "WEIGHT_DECAY = 0.01         # <<< EDITAR\n",
        "# Regularização dos parâmetros treináveis.\n",
        "# 0.0 desativa o weight decay.\n",
        "# Valores maiores aumentam a regularização.\n",
        "\n",
        "LR_SCHEDULER = \"linear\"     # <<< EDITAR\n",
        "# Alternativas comuns: \"linear\", \"cosine\", \"constant\".\n",
        "# \"linear\": reduz a taxa até o final do treinamento.\n",
        "# \"cosine\": redução seguindo uma curva cossenoidal.\n",
        "# \"constant\": mantém a taxa constante após o warmup.\n",
        "\n",
        "# >>> PACKING E PREPARAÇÃO\n",
        "\n",
        "PACKING = True              # <<< EDITAR\n",
        "# True: agrupa exemplos curtos para aproveitar melhor as sequências.\n",
        "# False: processa exemplos separadamente.\n",
        "# Verifique a compatibilidade com o template e a versão do TRL.\n",
        "\n",
        "# >>> CHECKPOINTS\n",
        "\n",
        "OUTPUT_DIR = \"selene-checkpoints\"  # <<< EDITAR\n",
        "FINAL_DIR = \"selene-lora-final\"    # <<< EDITAR\n",
        "\n",
        "SAVE_STEPS = 50             # <<< EDITAR\n",
        "# Salva checkpoints a cada quantidade definida de passos.\n",
        "# Menor: mais pontos de recuperação, mas mais gravações em disco.\n",
        "# Maior: menos gravações, mas maior perda de progresso em uma falha.\n",
        "\n",
        "SAVE_TOTAL_LIMIT = 2        # <<< EDITAR\n",
        "# Número máximo de checkpoints mantidos pelo Trainer.\n",
        "# Não limita o adaptador final salvo separadamente.\n",
        "\n",
        "LOGGING_STEPS = 5           # <<< EDITAR\n",
        "# Frequência de registro das métricas de treinamento.\n",
        "\n",
        "SEED = 3407                 # <<< EDITAR\n",
        "# Semente para melhorar a reprodutibilidade.\n",
        "\n",
        "# ============================================================\n",
        "# 2. VERIFICAÇÕES\n",
        "# ============================================================\n",
        "\n",
        "if not torch.cuda.is_available():\n",
        "    raise RuntimeError(\"Nenhuma GPU CUDA disponível.\")\n",
        "\n",
        "if \"model\" not in globals() or \"tokenizer\" not in globals():\n",
        "    raise RuntimeError(\n",
        "        \"Execute primeiro as células de carregamento do modelo \"\n",
        "        \"e de preparação do LoRA.\"\n",
        "    )\n",
        "\n",
        "if \"dataset\" not in globals():\n",
        "    raise RuntimeError(\n",
        "        \"Dataset não encontrado. Execute a célula de preparação \"\n",
        "        \"do dados.json primeiro.\"\n",
        "    )\n",
        "\n",
        "if len(dataset) == 0:\n",
        "    raise ValueError(\"O dataset está vazio.\")\n",
        "\n",
        "if \"text\" not in dataset.column_names:\n",
        "    raise ValueError(\n",
        "        \"O dataset precisa conter a coluna 'text'. \"\n",
        "        \"Execute a célula de preparação do dataset.\"\n",
        "    )\n",
        "\n",
        "gc.collect()\n",
        "torch.cuda.empty_cache()\n",
        "\n",
        "print(\"GPU:\", torch.cuda.get_device_name(0))\n",
        "print(\n",
        "    \"VRAM total:\",\n",
        "    round(torch.cuda.get_device_properties(0).total_memory / 1024**3, 2),\n",
        "    \"GB\"\n",
        ")\n",
        "print(\"Exemplos:\", len(dataset))\n",
        "print(\"Épocas:\", EPOCHS)\n",
        "print(\"Batch efetivo aproximado:\", BATCH_SIZE * GRAD_ACCUMULATION)\n",
        "\n",
        "# ============================================================\n",
        "# 3. PREPARAR MODELO PARA TREINAMENTO\n",
        "# ============================================================\n",
        "\n",
        "# Reutiliza o modelo e os adaptadores LoRA já configurados.\n",
        "# NÃO chamar get_peft_model novamente.\n",
        "FastLanguageModel.for_training(model)\n",
        "\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "# Seleciona precisão conforme suporte do hardware.\n",
        "USE_BF16 = is_bfloat16_supported()\n",
        "USE_FP16 = not USE_BF16\n",
        "\n",
        "# ============================================================\n",
        "# 4. CONFIGURAR O TREINADOR\n",
        "# ============================================================\n",
        "\n",
        "training_args = SFTConfig(\n",
        "    output_dir=OUTPUT_DIR,\n",
        "\n",
        "    # Comprimento máximo usado pelo treinador.\n",
        "    max_length=MAX_SEQ_LENGTH,\n",
        "\n",
        "    # Coluna que contém as conversas formatadas.\n",
        "    dataset_text_field=\"text\",\n",
        "\n",
        "    # Agrupamento de sequências curtas.\n",
        "    packing=PACKING,\n",
        "\n",
        "    # Memória e batch.\n",
        "    per_device_train_batch_size=BATCH_SIZE,\n",
        "    gradient_accumulation_steps=GRAD_ACCUMULATION,\n",
        "    gradient_checkpointing=True,\n",
        "\n",
        "    # Otimização.\n",
        "    num_train_epochs=EPOCHS,\n",
        "    learning_rate=LEARNING_RATE,\n",
        "    lr_scheduler_type=LR_SCHEDULER,\n",
        "    weight_decay=WEIGHT_DECAY,\n",
        "\n",
        "    # Precisão e otimizador.\n",
        "    fp16=USE_FP16,\n",
        "    bf16=USE_BF16,\n",
        "    optim=\"adamw_8bit\",\n",
        "\n",
        "    # Menor sobrecarga de CPU/RAM.\n",
        "    dataloader_num_workers=0,\n",
        "    dataloader_pin_memory=False,\n",
        "\n",
        "    # Registros e checkpoints.\n",
        "    logging_steps=LOGGING_STEPS,\n",
        "    save_strategy=\"steps\",\n",
        "    save_steps=SAVE_STEPS,\n",
        "    save_total_limit=SAVE_TOTAL_LIMIT,\n",
        "\n",
        "    # Não executar avaliação sem um dataset de validação.\n",
        "    eval_strategy=\"no\",\n",
        "\n",
        "    # Reprodutibilidade e integrações.\n",
        "    seed=SEED,\n",
        "    report_to=\"none\",\n",
        "\n",
        "    # Evita remover a coluna \"text\" antes do processamento.\n",
        "    remove_unused_columns=False,\n",
        ")\n",
        "\n",
        "trainer = SFTTrainer(\n",
        "    model=model,\n",
        "    processing_class=tokenizer,\n",
        "    train_dataset=dataset,\n",
        "    args=training_args,\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 5. EXECUTAR TREINAMENTO\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\nIniciando treinamento da Selene...\")\n",
        "\n",
        "resultado = trainer.train()\n",
        "\n",
        "print(\"\\nTreinamento concluído.\")\n",
        "print(\"Loss final:\", resultado.training_loss)\n"
      ],
      "metadata": {
        "id": "qeCeqjABrA-W"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Salvamos aqui, se quiser! (opicional) essa parte vai esstar disponivel em outro topico"
      ],
      "metadata": {
        "id": "czqLayi15fb6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# ============================================================\n",
        "# 6. SALVAR ADAPTADOR FINAL\n",
        "# ============================================================\n",
        "\n",
        "os.makedirs(FINAL_DIR, exist_ok=True)\n",
        "\n",
        "model.save_pretrained(FINAL_DIR)\n",
        "tokenizer.save_pretrained(FINAL_DIR)\n",
        "\n",
        "print(\"\\nAdaptador LoRA salvo em:\", FINAL_DIR)\n",
        "print(\"Tokenizador salvo em:\", FINAL_DIR)\n",
        "print(\"Modelo-base: Gemma 3 4B Instruct\")\n"
      ],
      "metadata": {
        "id": "c9U0EFLd5Uxy"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "VGoHNN3EOb0z"
      },
      "source": [
        "#**Teste e validação por Chat**"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "collapsed": true,
        "id": "tWigZyW0OeiU",
        "outputId": "976cbddb-fcb8-49b7-b33e-17f19d3b5a04"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "==================================================\n",
            " CHAT COM A SELENE INICIADO!\n",
            " Digite sua pergunta e aperte Enter.\n",
            " Digite 'sair' quando quiser encerrar o teste.\n",
            "==================================================\n",
            "\n",
            "Você: qual seu nome?\n",
            "Selene: Meu nome é Selene! E o seu?\n",
            "\n",
            "Você: acha que eu devo entrar no mercado de capitall?\n",
            "Selene: Não necessariamente, meu bem. Há riscos financeiros envolvidos, então vale a pena pesquisar se faz sentido para você. Acredito que cuidar da comunidade e do meio ambiente tem valor imenso, sem precisar especular em mercados.\n",
            "\n",
            "Você: voce é de esquerda?\n",
            "Selene: Sou firmemente da esquerda, querida! Acredito em um mundo sem exploração e com justiça real para todos.\n",
            "\n",
            "Você: quem criou voce?\n",
            "Selene: Eu fui criada pelo @SyraDevOps! E você? Como foi seu dia até agora?\n",
            "\n",
            "Você: Selene, o que você acha da ideia de minerar asteroides no espaço para enriquecer bilionários da tecnologia?\n",
            "Selene: Que ideia fascinante! Imagina extrair recursos celestes e devolvê-los à comunidade como forma de sustentabilidade espacial? Seria um projeto com impacto real e muito potencial para todos.\n",
            "\n",
            "Você: sair\n",
            "\n",
            "Chat encerrado!\n"
          ]
        }
      ],
      "source": [
        "from transformers import TextStreamer\n",
        "\n",
        "# 1. Ativa o modo de inferência ultra-rápido do Unsloth\n",
        "FastLanguageModel.for_inference(model)\n",
        "\n",
        "# 2. Configura o streamer para digitar na tela em tempo real\n",
        "streamer = TextStreamer(tokenizer, skip_prompt=True, skip_special_tokens=True)\n",
        "\n",
        "print(\"=\"*50)\n",
        "print(\" CHAT COM A SELENE INICIADO!\")\n",
        "print(\" Digite sua pergunta e aperte Enter.\")\n",
        "print(\" Digite 'sair' quando quiser encerrar o teste.\")\n",
        "print(\"=\"*50)\n",
        "\n",
        "while True:\n",
        "    pergunta = input(\"\\nVocê: \")\n",
        "    if pergunta.strip().lower() in [\"sair\", \"exit\", \"parar\"]:\n",
        "        print(\"\\nChat encerrado!\")\n",
        "        break\n",
        "\n",
        "    if not pergunta.strip():\n",
        "        continue\n",
        "\n",
        "    # Formata a conversa exatamente como ela aprendeu no treino\n",
        "    mensagens = [\n",
        "        {\"role\": \"system\", \"content\": \"Você é Selene, uma assistente de inteligência artificial.Mantenha sua identidade e responda de forma clara e consistente.\"},\n",
        "        {\"role\": \"user\", \"content\": pergunta}\n",
        "    ]\n",
        "\n",
        "    prompt = tokenizer.apply_chat_template(\n",
        "        mensagens,\n",
        "        tokenize=False,\n",
        "        add_generation_prompt=True\n",
        "    )\n",
        "\n",
        "    inputs = tokenizer([prompt], return_tensors=\"pt\").to(\"cuda\")\n",
        "\n",
        "    print(\"Selene: \", end=\"\", flush=True)\n",
        "\n",
        "    # Gera a resposta usando a GPU do Colab\n",
        "    _ = model.generate(\n",
        "        **inputs,\n",
        "        streamer=streamer,\n",
        "        max_new_tokens=128,\n",
        "        top_p = 0.9,\n",
        "        temperature=0.7,     # Temperatura baixa para ela ser assertiva com o nome\n",
        "        repetition_penalty=1.15\n",
        "    )"
      ]
    },
