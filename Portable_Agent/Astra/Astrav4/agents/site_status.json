{
  "name": "site_status",
  "description": "Verifica se um site está no ar e quanto demora (DNS, HTTP). Use para: “o github está fora do ar?”, “status do google.com”, “o site da uol está lento?”.",
  "resposta": "direta",
  "steps": [
    {
      "id": "criar_pasta",
      "type": "mkdir",
      "path": "rede"
    },
    {
      "id": "executar",
      "type": "python",
      "script": "site_status.py",
      "timeout": 30,
      "input": {
        "contexto": "{{context}}"
      },
      "network": true
    },
    {
      "id": "ler_resultado",
      "type": "read",
      "path": "rede/status.txt"
    }
  ]
}